<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Retirement Calculator</title>
    <style>
        .formatted-number {
            text-align: right;
        }
        body {
            font-family: Arial, sans-serif;
            max-width: 1000px;
            margin: 0 auto;
            padding: 20px;
            background-color: #f4f4f9;
        }
        h1, h2, h3 {
            color: #333;
        }
        form {
            background: #fff;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
            margin-bottom: 20px;
        }
        form div {
            margin-bottom: 15px;
        }
        label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
        }
        input[type="number"] {
            width: 100%;
            padding: 8px;
            box-sizing: border-box;
            border: 1px solid #ccc;
            border-radius: 4px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
            background: #fff;
        }
        table, th, td {
            border: 1px solid #ddd;
        }
        th, td {
            padding: 10px;
            text-align: left;
        }
        th {
            background-color: #f2f2f2;
        }
        button {
            background-color: #28a745;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 16px;
        }
        button:hover {
            background-color: #218838;
        }
        #results-container {
            margin-top: 30px;
        }
        canvas {
            margin-bottom: 30px;
            background: #fff;
            padding: 10px;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }
        #results-table {
            font-size: 14px;
        }
        .comparison-summary {
            display: flex;
            justify-content: space-around;
            background: #fff;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
            margin-bottom: 20px;
        }
        .summary-item {
            text-align: center;
        }
        .summary-item h4 {
            margin: 0 0 10px 0;
        }
        .summary-val {
            font-size: 1.2em;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <h1>Retirement Calculator</h1>

    <form id="simulation-form">
        <div>
            <label for="start_age">Start Age:</label>
            <input type="number" id="start_age" value="65">
        </div>
        <div>
            <label for="end_age">End Age:</label>
            <input type="number" id="end_age" value="95">
        </div>
        <div>
            <label for="spouse_death_age">Spouse Age at Death:</label>
            <input type="number" id="spouse_death_age" value="85">
        </div>
        <div>
            <label for="roth_balance">Initial Roth Balance:</label>
            <input type="number" id="roth_balance" value="200000">
        </div>
        <div>
            <label for="trad_balance">Initial Traditional (401k) Balance:</label>
            <input type="number" id="trad_balance" value="1500000">
        </div>
        <div>
            <label for="ss_income">Annual Social Security Income:</label>
            <input type="number" id="ss_income" value="40000">
        </div>
        <div>
            <label for="growth_rate">Annual Growth Rate (%):</label>
            <input type="number" id="growth_rate" step="0.1" value="5">
        </div>
        <div>
            <label for="withdrawal_rate">Annual Withdrawal Rate (%):</label>
            <input type="number" id="withdrawal_rate" step="0.1" value="12">
        </div>

        <h3>Standard Deduction</h3>
        <div>
            <label for="married_deduction">Married Deduction:</label>
            <input type="number" id="married_deduction" value="29200">
        </div>
        <div>
            <label for="single_deduction">Single Deduction:</label>
            <input type="number" id="single_deduction" value="14600">
        </div>

        <h3>Social Security Thresholds</h3>
        <div>
            <label for="married_ss_t1">Married Threshold 1:</label>
            <input type="number" id="married_ss_t1" value="32000">
        </div>
        <div>
            <label for="married_ss_t2">Married Threshold 2:</label>
            <input type="number" id="married_ss_t2" value="44000">
        </div>
        <div>
            <label for="single_ss_t1">Single Threshold 1:</label>
            <input type="number" id="single_ss_t1" value="25000">
        </div>
        <div>
            <label for="single_ss_t2">Single Threshold 2:</label>
            <input type="number" id="single_ss_t2" value="34000">
        </div>

        <h3>Tax Brackets (Married)</h3>
        <table id="married-brackets">
            <thead>
                <tr>
                    <th>Lower Bound</th>
                    <th>Upper Bound</th>
                    <th>Rate (%)</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><input type="number" value="0"></td>
                    <td><input type="number" value="22000"></td>
                    <td><input type="number" value="10"></td>
                </tr>
                <tr>
                    <td><input type="number" value="22000"></td>
                    <td><input type="number" value="89450"></td>
                    <td><input type="number" value="12"></td>
                </tr>
                <tr>
                    <td><input type="number" value="89450"></td>
                    <td><input type="number" value="190750"></td>
                    <td><input type="number" value="22"></td>
                </tr>
                <tr>
                    <td><input type="number" value="190750"></td>
                    <td><input type="number" value="364200"></td>
                    <td><input type="number" value="24"></td>
                </tr>
            </tbody>
        </table>

        <h3>Tax Brackets (Single)</h3>
        <table id="single-brackets">
            <thead>
                <tr>
                    <th>Lower Bound</th>
                    <th>Upper Bound</th>
                    <th>Rate (%)</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><input type="number" value="0"></td>
                    <td><input type="number" value="11000"></td>
                    <td><input type="number" value="10"></td>
                </tr>
                <tr>
                    <td><input type="number" value="11000"></td>
                    <td><input type="number" value="44725"></td>
                    <td><input type="number" value="12"></td>
                </tr>
                <tr>
                    <td><input type="number" value="44725"></td>
                    <td><input type="number" value="95375"></td>
                    <td><input type="number" value="22"></td>
                </tr>
                <tr>
                    <td><input type="number" value="95375"></td>
                    <td><input type="number" value="182100"></td>
                    <td><input type="number" value="24"></td>
                </tr>
            </tbody>
        </table>

        <button type="submit">Run Simulation</button>
    </form>

    <div id="results-container">
        <h2>Comparison Summary</h2>
        <div class="comparison-summary">
            <div class="summary-item">
                <h4>Scenario A (Stop at 22%)</h4>
                <p>Total Taxes: <span id="tax-a" class="summary-val">$0</span></p>
                <p>Ending Balance: <span id="bal-a" class="summary-val">$0</span></p>
            </div>
            <div class="summary-item">
                <h4>Scenario B (Go into 24%)</h4>
                <p>Total Taxes: <span id="tax-b" class="summary-val">$0</span></p>
                <p>Ending Balance: <span id="bal-b" class="summary-val">$0</span></p>
            </div>
        </div>

        <canvas id="balanceChart"></canvas>

        <h3>Detailed View (Scenario A)</h3>
        <table id="results-table">
            <thead>
                <tr>
                    <th>Age</th>
                    <th>Filing Status</th>
                    <th>Roth Balance</th>
                    <th>Traditional Balance</th>
                    <th>Withdrawal</th>
                    <th>Total Income</th>
                    <th>Taxes</th>
                    <th>Net Income</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        function calculateTax(income, brackets) {
            let tax = 0;
            for (const [lower, upper, rate] of brackets) {
                if (income > lower) {
                    const taxedAmount = Math.min(income, upper) - lower;
                    tax += taxedAmount * rate;
                } else {
                    break;
                }
            }
            return tax;
        }

        function formatNumber(val) {
            if (isNaN(val)) return "";
            return val.toLocaleString('en-US', { maximumFractionDigits: 2 });
        }

        function unformatNumber(str) {
            return parseFloat(str.replace(/,/g, '')) || 0;
        }

        function handleInput(e) {
            const cursorStart = e.target.selectionStart;
            const originalLength = e.target.value.length;
            const value = unformatNumber(e.target.value);
            e.target.value = formatNumber(value);
            const newLength = e.target.value.length;
            e.target.setSelectionRange(cursorStart + (newLength - originalLength), cursorStart + (newLength - originalLength));
        }

        document.querySelectorAll('input[type="number"]:not([step="0.1"]):not([id="start_age"]):not([id="end_age"]):not([id="spouse_death_age"])').forEach(input => {
            input.type = "text";
            input.classList.add('formatted-number');
            input.value = formatNumber(parseFloat(input.value));
            input.addEventListener('input', handleInput);
        });

        function calculateTaxableSS(withdrawal, ss_income, status, t1, t2) {
            const provisional_income = withdrawal + 0.5 * ss_income;
            if (provisional_income < t1) return 0;
            if (provisional_income < t2) return 0.5 * ss_income;
            return 0.85 * ss_income;
        }

        function getBracketsFromTable(tableId) {
            const table = document.getElementById(tableId);
            const rows = table.querySelectorAll('tbody tr');
            const brackets = [];
            rows.forEach(row => {
                const inputs = row.querySelectorAll('input');
                const lower = unformatNumber(inputs[0].value);
                const upper = unformatNumber(inputs[1].value);
                const rate = parseFloat(inputs[2].value) / 100;
                brackets.push([lower, upper, rate]);
            });
            return brackets;
        }

        let balanceChart = null;

        function updateUI(resultsA, resultsB) {
            // Update Summary
            const totalTaxA = resultsA.reduce((sum, r) => sum + r.Taxes, 0);
            const totalTaxB = resultsB.reduce((sum, r) => sum + r.Taxes, 0);
            const endBalA = resultsA[resultsA.length - 1].RothBalance + resultsA[resultsA.length - 1].TraditionalBalance;
            const endBalB = resultsB[resultsB.length - 1].RothBalance + resultsB[resultsB.length - 1].TraditionalBalance;

            document.getElementById('tax-a').innerText = totalTaxA.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
            document.getElementById('tax-b').innerText = totalTaxB.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
            document.getElementById('bal-a').innerText = endBalA.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
            document.getElementById('bal-b').innerText = endBalB.toLocaleString('en-US', { style: 'currency', currency: 'USD' });

            // Update Table (Detailed Scenario A)
            const tableBody = document.querySelector('#results-table tbody');
            tableBody.innerHTML = '';
            resultsA.forEach(row => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${row.Age}</td>
                    <td>${row.FilingStatus}</td>
                    <td>${row.RothBalance.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}</td>
                    <td>${row.TraditionalBalance.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}</td>
                    <td>${(row.WithdrawalTrad + row.WithdrawalRoth).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}</td>
                    <td>${row.TotalIncome.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}</td>
                    <td>${row.Taxes.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}</td>
                    <td>${row.NetIncome.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}</td>
                `;
                tableBody.appendChild(tr);
            });

            // Update Chart
            const labels = resultsA.map(r => r.Age);
            const ctx = document.getElementById('balanceChart').getContext('2d');
            if (balanceChart) {
                balanceChart.destroy();
            }
            balanceChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Roth (A)',
                            data: resultsA.map(r => r.RothBalance),
                            borderColor: 'blue',
                            fill: false
                        },
                        {
                            label: 'Trad (A)',
                            data: resultsA.map(r => r.TraditionalBalance),
                            borderColor: 'green',
                            fill: false
                        },
                        {
                            label: 'Roth (B)',
                            data: resultsB.map(r => r.RothBalance),
                            borderColor: 'cyan',
                            borderDash: [5, 5],
                            fill: false
                        },
                        {
                            label: 'Trad (B)',
                            data: resultsB.map(r => r.TraditionalBalance),
                            borderColor: 'orange',
                            borderDash: [5, 5],
                            fill: false
                        }
                    ]
                },
                options: {
                    responsive: true,
                    plugins: {
                        title: {
                            display: true,
                            text: 'Retirement Account Balances (Solid = Scenario A, Dashed = Scenario B)'
                        }
                    }
                }
            });
        }

        function runSimulation(strategy, inputs) {
            const results = [];
            let rothBalance = inputs.rothBalance;
            let tradBalance = inputs.tradBalance;

            for (let age = inputs.startAge; age <= inputs.endAge; age++) {
                const filingStatus = age < inputs.spouseDeathAge ? "married" : "single";
                const brackets = filingStatus === "married" ? inputs.marriedBrackets : inputs.singleBrackets;
                const deduction = filingStatus === "married" ? inputs.marriedDeduction : inputs.singleDeduction;
                const ssT1 = filingStatus === "married" ? inputs.marriedSST1 : inputs.singleSST1;
                const ssT2 = filingStatus === "married" ? inputs.marriedSST2 : inputs.singleSST2;

                const limit22 = brackets.length > 2 ? brackets[2][1] : 999999999;

                rothBalance *= (1 + inputs.growthRate);
                tradBalance *= (1 + inputs.growthRate);

                const targetWithdrawal = tradBalance * inputs.withdrawalRate;
                let withdrawalTrad = 0;
                let withdrawalRoth = 0;

                if (strategy === 'B') {
                    withdrawalTrad = Math.min(targetWithdrawal, tradBalance);
                    tradBalance -= withdrawalTrad;
                    withdrawalRoth = Math.min(targetWithdrawal - withdrawalTrad, rothBalance);
                    rothBalance -= withdrawalRoth;
                } else {
                    // Strategy A: binary search
                    let low = 0;
                    let high = targetWithdrawal;
                    let bestTrad = 0;
                    for (let i = 0; i < 20; i++) {
                        let mid = (low + high) / 2;
                        let taxableSS = calculateTaxableSS(mid, inputs.ssIncome, filingStatus, ssT1, ssT2);
                        let taxableIncome = Math.max(0, mid + taxableSS - deduction);
                        if (taxableIncome <= limit22) {
                            bestTrad = mid;
                            low = mid;
                        } else {
                            high = mid;
                        }
                    }
                    withdrawalTrad = Math.min(bestTrad, tradBalance);
                    tradBalance -= withdrawalTrad;
                    withdrawalRoth = Math.min(targetWithdrawal - withdrawalTrad, rothBalance);
                    rothBalance -= withdrawalRoth;
                }

                const taxableSS = calculateTaxableSS(withdrawalTrad, inputs.ssIncome, filingStatus, ssT1, ssT2);
                const taxableIncome = Math.max(0, withdrawalTrad + taxableSS - deduction);
                const taxes = calculateTax(taxableIncome, brackets);
                const totalIncome = inputs.ssIncome + withdrawalTrad + withdrawalRoth;
                const netIncome = totalIncome - taxes;

                results.push({
                    Age: age,
                    FilingStatus: filingStatus,
                    RothBalance: rothBalance,
                    TraditionalBalance: tradBalance,
                    WithdrawalTrad: withdrawalTrad,
                    WithdrawalRoth: withdrawalRoth,
                    TotalIncome: totalIncome,
                    Taxes: taxes,
                    NetIncome: netIncome
                });
            }
            return results;
        }

        document.getElementById('simulation-form').addEventListener('submit', function(e) {
            e.preventDefault();

            const inputs = {
                startAge: parseInt(document.getElementById('start_age').value),
                endAge: parseInt(document.getElementById('end_age').value),
                spouseDeathAge: parseInt(document.getElementById('spouse_death_age').value),
                rothBalance: unformatNumber(document.getElementById('roth_balance').value),
                tradBalance: unformatNumber(document.getElementById('trad_balance').value),
                ssIncome: unformatNumber(document.getElementById('ss_income').value),
                growthRate: parseFloat(document.getElementById('growth_rate').value) / 100,
                withdrawalRate: parseFloat(document.getElementById('withdrawal_rate').value) / 100,
                marriedBrackets: getBracketsFromTable('married-brackets'),
                singleBrackets: getBracketsFromTable('single-brackets'),
                marriedDeduction: unformatNumber(document.getElementById('married_deduction').value),
                singleDeduction: unformatNumber(document.getElementById('single_deduction').value),
                marriedSST1: unformatNumber(document.getElementById('married_ss_t1').value),
                marriedSST2: unformatNumber(document.getElementById('married_ss_t2').value),
                singleSST1: unformatNumber(document.getElementById('single_ss_t1').value),
                singleSST2: unformatNumber(document.getElementById('single_ss_t2').value),
            };

            const resultsA = runSimulation('A', inputs);
            const resultsB = runSimulation('B', inputs);

            updateUI(resultsA, resultsB);
        });
    </script>
</body>
</html>
